{
  "name": "mh-neri-ph",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "db:up": "docker compose up -d",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force && pnpm db:seed",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint . && prettier --check .",
    "typecheck": "astro check",
    "audit": "pnpm audit --audit-level=moderate",
    "postinstall": "prisma generate",
    "test:integration": "RATELIMIT_IT=1 CONTACT_IT=1 LOGIN_IT=1 PROJECTS_IT=1 STACK_IT=1 UPLOAD_IT=1 MESSAGES_IT=1 SEO_IT=1 vitest run --no-file-parallelism src/lib/__tests__/ratelimit.integration.test.ts src/pages/api/__tests__/contact.integration.test.ts src/lib/__tests__/login.integration.test.ts src/lib/__tests__/projects.integration.test.ts src/lib/__tests__/stack.integration.test.ts src/lib/__tests__/upload.integration.test.ts src/lib/__tests__/messages.integration.test.ts src/pages/__tests__/seo.integration.test.ts"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.4",
    "@aws-sdk/client-s3": "^3.1119.0",
    "@aws-sdk/s3-request-presigner": "^3.1119.0",
    "@node-rs/argon2": "^2.1.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "astro": "^7.2.8",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "resend": "^6.24.0",
    "sharp": "^0.35.4",
    "ulid": "^3.0.2",
    "unified": "^11.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "axe-core": "^4.13.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": ">=8.0.0"
    }
  }
}

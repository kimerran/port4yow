# Copy to .env. Every variable here is validated by src/lib/env.ts at boot.
#
# Much shorter than it was: DATABASE_URL, the S3 block, the admin credentials,
# SESSION_SECRET and REDIS_URL are gone with the database, the object store and
# the admin. What remains is what the one dynamic route (POST /api/contact)
# actually needs.

# --- Core ---------------------------------------------------------------
NODE_ENV=development
PORT=4321

# Must be an absolute http(s) URL. A bare host:port parses but has no origin,
# which silently disables the CSRF origin check. Also the source of `site` in
# astro.config.mjs, so a production BUILD fails without it rather than baking
# localhost into the sitemap and canonicals.
PUBLIC_SITE_URL=http://localhost:4321

# --- Secrets ------------------------------------------------------------
# Generate each with: openssl rand -base64 48
# 32 characters is the floor. Never commit real values.
FORM_SECRET=
IP_HASH_SALT=

# --- Email --------------------------------------------------------------
# false in dev, so mail goes to the Mailpit container instead of Resend and
# nothing leaves the machine. Setting this true without RESEND_API_KEY is
# refused at boot rather than silently dropping mail.
RESEND_ENABLED=false
RESEND_API_KEY=
CONTACT_FROM_EMAIL=hello@mh.neri.ph
CONTACT_TO_EMAIL=you@example.com
SMTP_URL=smtp://localhost:1025

# --- Logging ------------------------------------------------------------
LOG_LEVEL=info

---
/**
 * BRAND §4 — a 60°/120° rhombus lattice derived from the diamond pip, rendered as
 * a fixed inline SVG pattern. `ink-navy` hairlines at 3% opacity, dropping to 2%
 * on mobile.
 *
 * This is the one place BRAND permits arbitrary values (AGENT §2): the geometry is
 * a lattice, not a token scale.
 *
 * aria-hidden and pointer-events-none — it is texture, never content, and must
 * never intercept a click or reach the accessibility tree.
 */
---

<svg
  class="pointer-events-none fixed inset-0 -z-10 h-full w-full opacity-[0.02] md:opacity-[0.03]"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <!-- 60°/120° rhombus: width 40, height 40*tan(60°)/2 ≈ 34.64 -->
    <pattern id="facet" width="40" height="34.64" patternUnits="userSpaceOnUse">
      <path
        d="M0 17.32 L20 0 L40 17.32 L20 34.64 Z"
        fill="none"
        stroke="var(--color-ink-navy)"
        stroke-width="1"></path>
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill="url(#facet)"></rect>
</svg>

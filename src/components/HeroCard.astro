---
import Panel from "./Panel.astro";

/**
 * BRAND §5 — the signature element.
 *
 * This was a Jack of Diamonds: a 5:7 card face with a Bodoni "J" over a diamond
 * pip in each of two opposite corners, dealt in with a rotate-and-slide entrance.
 * The card metaphor has been removed from the site, so what remains is the part
 * that was never about playing cards — the monogram watermark, the stack list,
 * and the single radial gold wash behind it.
 *
 * With the deal gone there is no entrance animation on the site at all. That is
 * the intended end state, not an oversight: BRAND §5 called the deal "the only
 * entrance animation", and removing the thing being dealt removes its reason to
 * exist.
 */
interface Props {
  /** Set in IBM Plex Mono at 10px along the lower half of the well. */
  stack?: string[];
  /** Rendered at 10% opacity in the inset well. */
  monogram?: string;
}

const { stack = [], monogram = "MHN" } = Astro.props;
---

{
  /* The single radial metallic-gold wash at 8%, falling off fast into cool-stock.
    Decorative, so it never reaches the accessibility tree. */
}
<div class="relative flex items-center justify-center" data-hero-panel>
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="h-full w-full hero-wash"></div>
  </div>

  {/* 280px mobile / 380px desktop, per BRAND §5. */}
  <div class="w-[280px] md:w-[380px]">
    <Panel class="flex flex-col gap-md p-md">
      {
        /* The inset well. It kept a fixed height when the 5:7 ratio set the
          panel's height; now that the panel is content-sized, the well carries
          its own aspect ratio so the monogram has room to be a watermark rather
          than a line of text. */
      }
      <div
        class="relative flex aspect-[4/3] flex-col justify-end overflow-hidden rounded bg-surface-sunken p-sm"
      >
        {
          /* text-[96px] rather than text-display-xl: BRAND §3 sets display-xl to
            96px, but #9 made that utility responsive (44/56/96) so the hero name
            never overflows a phone. The monogram is a fixed-size watermark inside
            a fixed-size panel, so it must not shrink with the viewport — it needs
            the 96px value without the breakpoints. AGENT §2 asks for arbitrary
            values to be justified rather than assumed; this is that justification. */
        }
        <span
          class="pointer-events-none absolute inset-0 flex items-center justify-center font-display text-[96px] leading-none text-ink-navy opacity-10 select-none"
          aria-hidden="true">{monogram}</span
        >
        {
          stack.length > 0 && (
            <ul class="relative flex flex-col gap-xs font-mono text-[10px] leading-tight text-ink-muted">
              {stack.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          )
        }
      </div>
    </Panel>
  </div>
</div>

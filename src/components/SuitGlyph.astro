---
/**
 * BRAND §6 — suits are taxonomy, not ornament.
 *
 *
 * Inline SVG, never an icon font — BRAND §6 removes the mock's Material Symbols
 * dependency, and §10 rejects icon fonts outright.
 *
 * `aria-hidden` always: the glyph never carries meaning on its own. Every caller
 * pairs it with visible or screen-reader text (BRAND §6, §9).
 */
import type { Suit } from "../lib/suits";

interface Props {
  suit: Suit;
  class?: string;
}

const { suit, class: className = "h-4 w-4" } = Astro.props;

const paths: Record<Suit, string> = {
  diamonds: "M12 2 L20 12 L12 22 L4 12 Z",
  spades:
    "M12 2 C12 2 4 9 4 14 a4 4 0 0 0 7 2.6 c-.2 2-.8 3.4-2 4.4 h6 c-1.2-1-1.8-2.4-2-4.4 A4 4 0 0 0 20 14 C20 9 12 2 12 2 Z",
  hearts:
    "M12 21 C12 21 3 14.5 3 8.8 A4.8 4.8 0 0 1 12 6.4 A4.8 4.8 0 0 1 21 8.8 C21 14.5 12 21 12 21 Z",
  clubs:
    "M12 2 a4 4 0 0 1 3.2 6.4 A4 4 0 1 1 16 16.4 a4.6 4.6 0 0 1-3-1.5 c.1 2.2.7 3.9 2 5.1 H9 c1.3-1.2 1.9-2.9 2-5.1 a4.6 4.6 0 0 1-3 1.5 A4 4 0 1 1 8.8 8.4 A4 4 0 0 1 12 2 Z",
};
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
>
  <path d={paths[suit]}></path>
</svg>

---
import { createFormToken } from "../lib/formToken";
import Button from "./Button.astro";

/**
 * The public contact form (SPEC §7, BRAND §7/§8/§9, #21).
 *
 * Works with JavaScript disabled and is better with it: the markup is a plain
 * `POST` to `/api/contact` that fully works on its own, and `contact-form.ts`
 * upgrades it in place to a `fetch` that keeps the entered values and renders
 * inline errors.
 *
 * Every `name`, `id` and `data-` hook here is part of the contract with both
 * `contact-form.ts` and #22's handler — renaming one breaks the no-JS path
 * silently, which is the path nobody tests by hand.
 */

const renderedAt = createFormToken();

const field =
  "min-h-11 w-full rounded border border-outline-variant bg-card-face px-md py-sm text-body-md text-ink-navy";
const label = "font-mono text-label-sm text-ink-muted";
const errorText = "text-[14px] text-error";
---

<form
  id="contact-form"
  method="POST"
  action="/api/contact"
  class="flex max-w-[560px] flex-col gap-lg"
  novalidate
>
  {/* Signed at render time; #22 checks the signature and the age. */}
  <input type="hidden" name="renderedAt" value={renderedAt} />

  {
    /* Honeypot. Visually hidden via CSS and NEVER type="hidden" — a bot reads
       the DOM, and a hidden input is the one thing it knows to skip. Off-screen
       rather than display:none for the same reason. aria-hidden and tabindex=-1
       keep it away from a keyboard or screen-reader user, who would otherwise
       be asked to fill in a field that marks them as spam. */
  }
  <div
    class="absolute -left-[9999px] h-0 w-0 overflow-hidden"
    aria-hidden="true"
  >
    <label for="contact-company">Company</label>
    <input
      id="contact-company"
      name="company"
      type="text"
      tabindex="-1"
      autocomplete="off"
    />
  </div>

  <div class="flex flex-col gap-xs">
    <label class={label} for="contact-name">Name</label>
    <input
      id="contact-name"
      name="name"
      type="text"
      required
      maxlength="120"
      autocomplete="name"
      class={field}
      aria-describedby="contact-name-error"
    />
    <p id="contact-name-error" class={errorText} data-error-for="name"></p>
  </div>

  <div class="flex flex-col gap-xs">
    <label class={label} for="contact-email">Email</label>
    <input
      id="contact-email"
      name="email"
      type="email"
      required
      maxlength="255"
      autocomplete="email"
      class={field}
      aria-describedby="contact-email-error"
    />
    <p id="contact-email-error" class={errorText} data-error-for="email"></p>
  </div>

  <div class="flex flex-col gap-xs">
    <label class={label} for="contact-message">Message</label>
    <textarea
      id="contact-message"
      name="message"
      required
      rows="6"
      maxlength="5000"
      class={`${field} min-h-32 resize-y`}
      aria-describedby="contact-message-error"></textarea>
    <p id="contact-message-error" class={errorText} data-error-for="message">
    </p>
  </div>

  {
    /* One live region for the whole form. BRAND §9 asks for polite
       announcement; a region per field would interrupt itself when several
       fail at once. It is in the DOM from first render — a live region added
       to the page at the moment it gains text is frequently not announced. */
  }
  <p class="text-body-md" data-form-status role="status" aria-live="polite"></p>

  <div>
    <Button type="submit" class="w-full sm:w-auto">Send message</Button>
  </div>
</form>

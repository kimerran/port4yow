---
/**
 * BRAND §4/§7 — the card ratio governs. 5:7, `card-face`, 1px `deep-teal`/15%,
 * `radius-lg` 8px, `--shadow-card`.
 *
 * Nothing on this site is a circle or a perfect square, and there is no
 * `rounded-full` anywhere.
 */
interface Props {
  /** Renders as <a> when set, so the whole card is one link target. */
  href?: string;
  class?: string;
  /** Tile lift on hover. Off for static surfaces. */
  interactive?: boolean;
}

const { href, class: className = "", interactive = false } = Astro.props;
const Tag = href ? "a" : "div";

const base =
  "aspect-card card-shadow relative block overflow-hidden rounded-lg border border-deep-teal/15 bg-card-face";
---

<Tag
  {...href ? { href } : {}}
  class:list={[base, interactive && "card-hover", className]}
>
  <slot />
</Tag>

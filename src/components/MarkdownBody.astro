---
import { renderMarkdown } from "../lib/markdown";

/**
 * Renders `Project.body` (SPEC §5 block 4).
 *
 * The ONLY consumer of `renderMarkdown`, and the only place `set:html` touches
 * project content — the same shape as `JsonLd.astro` (#15): the exception is
 * scoped to one purpose-built component, and the ESLint rule stays on everywhere
 * else.
 *
 * SPEC §14.6 permits `set:html` exactly here: "Markdown that has passed a
 * sanitizer allowlist". See src/lib/markdown.ts for the two layers.
 */
interface Props {
  markdown: string;
  class?: string;
}

const { markdown, class: className = "" } = Astro.props;
const html = await renderMarkdown(markdown);
---

<div class:list={["markdown-body", className]} set:html={html} />

---
import type { NextProject } from "../lib/project";
import Panel from "./Panel.astro";
import { SUIT_CATEGORY } from "../lib/suits";

/**
 * The "next project" footer (SPEC §5, #18).
 *
 * This was a face-down card back that flipped on hover or focus to reveal the
 * title. The flip went with the card metaphor, and with it the whole reason this
 * component was delicate: the reveal was presentational, so the accessible name
 * had to come from the face-up side while the back stayed `aria-hidden`, and
 * BRAND §9's ban on hover-only affordances meant `group-focus-visible` had to
 * drive the same flip as `group-hover`.
 *
 * A plain link has none of those failure modes — the title is simply always
 * visible and always in the accessibility tree. The hover affordance is now the
 * same lift every other tile uses.
 *
 * The category is shown rather than the raw suit name: "Open source" is what
 * `hearts` meant, and without a pip beside it the bare word meant nothing.
 */
interface Props {
  next: NextProject;
}

const { next } = Astro.props;
---

<nav aria-label="Next project" class="flex flex-col gap-md">
  <h2 class="font-mono text-label-sm tracking-wide text-ink-muted uppercase">
    Next project
  </h2>

  <Panel
    href={`/work/${next.slug}`}
    interactive
    class="flex w-full max-w-[280px] flex-col gap-sm p-md"
  >
    <span class="font-display text-headline-md">{next.title}</span>
    <span class="text-label-sm text-ink-muted">
      {SUIT_CATEGORY[next.suit]}
    </span>
  </Panel>
</nav>

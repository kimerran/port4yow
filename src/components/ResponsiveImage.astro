---
import { buildPicture, type AssetLike } from "../lib/images";

/**
 * Responsive image (SPEC §5, §15).
 *
 * AVIF first, WebP fallback, explicit width/height so the box is reserved before
 * the bytes arrive (CLS < 0.05), lazy below the fold, and an LQIP from
 * `blurDataUrl` as the placeholder.
 *
 * `assets` is every derivative that EXISTS for this image — see src/lib/images.ts
 * for why the srcset cannot be derived from the key pattern alone.
 */
export interface Props {
  assets: AssetLike[];
  caption?: string | null;
  /** Above-the-fold images opt out of lazy loading. */
  eager?: boolean;
  sizes?: string;
}

const {
  assets,
  caption,
  eager = false,
  // Measured, not guessed: the figure spans the content container, which renders
  // at ~85-91% of the viewport at 320/375/768/1024/1440. `ch` is wrong here —
  // in `sizes` it resolves against the ROOT font, not the content font, and
  // under-declared the width badly enough that a 1230px box pulled the 960w file.
  // These vw values round UP against every measured width, so the browser never
  // picks a candidate narrower than the box. The container itself caps at
  // 1230px, so above 1440px a fixed 1240px stops the 1920w file being fetched
  // for a box that can never use it (a 2x screen still scales up to 1920).
  sizes = "(min-width: 1440px) 1240px, (min-width: 1024px) 88vw, 92vw",
} = Astro.props;

const picture = buildPicture(assets);

// LQIP: the tiny base64 preview is rendered as a real <img> stacked BEHIND the
// picture, not as a CSS background. Two constraints force that shape:
//   * CSP blocks static style="" attributes (#11), and CSS cannot read a data-
//     attribute into a url() — attr() does not work there. So no background-image.
//   * A stacked img needs no script to dismiss: the real image occupies the same
//     box and paints over it opaquely once decoded.
// `img-src 'self' data:` in astro.config.mjs is what permits the data URI.
const lqip = picture.blurDataUrl;
---

<figure class="flex flex-col gap-sm">
  <div
    class="relative overflow-hidden rounded border border-outline-variant bg-surface-sunken"
  >
    {
      lqip && (
        <img
          src={lqip}
          alt=""
          aria-hidden="true"
          width={picture.width ?? undefined}
          height={picture.height ?? undefined}
          class="absolute inset-0 h-full w-full scale-105 blur-lg"
        />
      )
    }
    <picture>
      {
        picture.sources.map((source) => (
          <source type={source.type} srcset={source.srcset} sizes={sizes} />
        ))
      }
      <img
        src={picture.src}
        alt={picture.alt}
        width={picture.width ?? undefined}
        height={picture.height ?? undefined}
        loading={eager ? "eager" : "lazy"}
        decoding="async"
        fetchpriority={eager ? "high" : "auto"}
        sizes={sizes}
        class="relative h-auto w-full"
      />
    </picture>
  </div>
  {
    caption && (
      <figcaption class="font-mono text-label-sm text-ink-muted">
        {caption}
      </figcaption>
    )
  }
</figure>

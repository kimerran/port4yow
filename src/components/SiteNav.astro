---
import ScrollRail from "./ScrollRail.astro";

/**
 * One navigation, at the top, at every width.
 *
 * ## What changed and why the comment above it moved
 *
 * BRAND §7 previously shipped an 80px left rail on desktop and a 56px sticky top
 * bar on mobile — two presentations of one `<nav>`, mutually exclusive at `md`.
 * That resolved a collision in the mock, which defined both. This is now a
 * single top bar everywhere. BRAND §7 is updated to match; a component that
 * contradicts the document it cites is worse than either choice.
 *
 * Still exactly one `<nav>` in the DOM, so the accessibility tree never contains
 * two navigation regions — the property the old two-presentation split was
 * carefully preserving, now true by construction rather than by breakpoint.
 *
 * ## The labels are text, at every width
 *
 * These links briefly carried a suit glyph with the label `sr-only` below `sm`,
 * which fit because the glyph was doing the work on a phone. The suits are gone
 * from the site, so a hidden label would leave the bar visually empty at 375px —
 * the labels are now visible everywhere, and the horizontal padding tightens
 * below `sm` to buy the room that costs. Measured at 375px, not assumed.
 *
 * The section headings are "Projects" and "The stack" (BRAND §8). A nav is not a
 * heading: the full set does not fit a bar at 375px, and a link labelled "Work"
 * pointing at a section titled "Projects" reads correctly.
 */

const links = [
  { href: "/#work", label: "Work" },
  { href: "/#stack", label: "Stack" },
  { href: "/#background", label: "Background" },
  { href: "/#contact", label: "Contact" },
];
---

<nav
  aria-label="Primary"
  class="sticky top-0 z-20 flex h-14 items-center justify-between gap-sm border-b border-outline-variant bg-surface-raised px-sm sm:gap-md sm:px-md md:px-lg"
>
  {
    /*
      WCAG 2.5.3 (Label in Name): the accessible name must CONTAIN the visible
      text. `MHN` under an `aria-label` of "Home — Mark Hugh Neri" failed that —
      a voice-control user saying "click MHN" could not activate it, and
      Lighthouse flagged `label-content-name-mismatch` (#40).

      The visible text is still the whole accessible name here. `MHN` below
      `sm`, the full name above it, and the `sr-only` suffix carries the rest —
      so whichever half is on screen, the name starts with what you can read.
    */
  }
  <a
    href="/"
    class="flex h-11 min-w-11 shrink-0 items-center rounded pr-xs font-mono text-index-rank text-ink-navy sm:pr-sm"
    ><span class="sm:hidden">MHN</span><span class="hidden sm:inline"
      >Mark Hugh Neri</span
    ><span class="sr-only"> — home</span></a
  >

  {
    /*
      The list scrolls sideways below `sm` rather than the page doing it.

      Five items at a 44px floor plus "Background" at 92px do not fit 320px —
      measured at 42px of page overflow, caught by responsive.spec's 320 guard.
      The alternatives were all worse: shrinking the labels below BRAND §3's
      12px, abbreviating "Background" into something that no longer matches the
      heading it points at, dropping an item on small screens, or wrapping to a
      second row (which breaks the scroll rail's `top-14` offset).

      `min-w-0` is the part that does the work: a flex child defaults to
      `min-width: auto` and refuses to shrink below its content, which is what
      pushed the overflow onto the page in the first place.
    */
  }
  <ul
    class="flex min-w-0 [scrollbar-width:none] items-center overflow-x-auto [&::-webkit-scrollbar]:hidden"
  >
    {
      links.map((link) => (
        <li>
          <a
            href={link.href}
            class="nav-underline flex h-11 min-w-11 items-center justify-center rounded px-xs font-mono text-label-sm text-ink-muted uppercase transition-colors hover:text-ink-navy motion-reduce:transition-none sm:px-sm"
          >
            {link.label}
          </a>
        </li>
      ))
    }

    <li>
      {
        /* The resume, styled as a button so it reads as a thing you get rather
          than a place you go — the other four are in-page anchors.

          The word is `sr-only` below `sm` and the arrow carries it visually,
          because four section labels plus "RESUME" do not fit 375px. One element
          with `sr-only sm:not-sr-only` rather than a visible span and an
          `sr-only` twin: the twin puts the word in the DOM twice and lets the
          two drift apart. The arrow is `aria-hidden`, so the accessible name is
          "Resume (PDF download)" at every width.

          A real anchor to the static file, so it downloads with JavaScript off;
          `access-gate.ts` hangs the download report on `data-resume-link`.

          `relative` is load-bearing, not decoration. `sr-only` is
          `position: absolute`, so an unpositioned anchor hands its hidden text
          to the nearest positioned ancestor — the sticky <nav> — which puts it
          OUTSIDE the list's `overflow-x-auto` and therefore outside its
          clipping. Measured: 19px of page overflow at 320px from two invisible
          spans. The section links get this for free from `nav-underline`, which
          sets `position: relative` for its underline. */
      }
      <a
        href="/resume.pdf"
        download="Mark-Hugh-Neri-resume.pdf"
        data-resume-link
        class="relative ml-xs flex h-11 min-w-11 items-center justify-center gap-xs rounded border border-outline-variant px-xs font-mono text-label-sm text-ink-navy uppercase transition-colors hover:border-deep-teal hover:text-deep-teal motion-reduce:transition-none sm:ml-sm sm:px-sm"
      >
        <span class="sr-only sm:not-sr-only">Resume</span>
        <span aria-hidden="true">↓</span>
        <span class="sr-only">(PDF download)</span>
      </a>
    </li>
  </ul>
</nav>

{
  /*
    The scroll rail, directly under the bar.

    BRAND §7 put it at the base of the left rail on desktop and made it a 2px
    top bar on mobile. With no left rail there is only one place it can live, so
    the `bar` variant now serves every width — which is what the mobile
    treatment always was.
  */
}
<div class="sticky top-14 z-20">
  <ScrollRail variant="bar" />
</div>

---
import ScrollRail from "./ScrollRail.astro";

/**
 * One navigation, at the top, at every width.
 *
 * ## What changed and why the comment above it moved
 *
 * BRAND §7 previously shipped an 80px left rail on desktop and a 56px sticky top
 * bar on mobile — two presentations of one `<nav>`, mutually exclusive at `md`.
 * That resolved a collision in the mock, which defined both. This is now a
 * single top bar everywhere. BRAND §7 is updated to match; a component that
 * contradicts the document it cites is worse than either choice.
 *
 * Still exactly one `<nav>` in the DOM, so the accessibility tree never contains
 * two navigation regions — the property the old two-presentation split was
 * carefully preserving, now true by construction rather than by breakpoint.
 *
 * ## The labels are text, at every width
 *
 * These links briefly carried a suit glyph with the label `sr-only` below `sm`,
 * which fit because the glyph was doing the work on a phone. The suits are gone
 * from the site, so a hidden label would leave the bar visually empty at 375px —
 * the labels are now visible everywhere, and the horizontal padding tightens
 * below `sm` to buy the room that costs. Measured at 375px, not assumed.
 *
 * The section headings are "Selected work" and "The stack" (BRAND §8). A nav is
 * not a heading: four full headings do not fit a bar at 375px, and a link
 * labelled "Work" pointing at a section titled "Selected work" reads correctly.
 */

const links = [
  { href: "/#work", label: "Work" },
  { href: "/#stack", label: "Stack" },
  { href: "/#background", label: "Background" },
  { href: "/#contact", label: "Contact" },
];
---

<nav
  aria-label="Primary"
  class="sticky top-0 z-20 flex h-14 items-center justify-between gap-sm border-b border-outline-variant bg-surface-raised px-sm sm:gap-md sm:px-md md:px-lg"
>
  {
    /*
      WCAG 2.5.3 (Label in Name): the accessible name must CONTAIN the visible
      text. `MHN` under an `aria-label` of "Home — Mark Hugh Neri" failed that —
      a voice-control user saying "click MHN" could not activate it, and
      Lighthouse flagged `label-content-name-mismatch` (#40).

      The visible text is still the whole accessible name here. `MHN` below
      `sm`, the full name above it, and the `sr-only` suffix carries the rest —
      so whichever half is on screen, the name starts with what you can read.
    */
  }
  <a
    href="/"
    class="flex h-11 min-w-11 shrink-0 items-center rounded pr-xs font-mono text-index-rank text-ink-navy sm:pr-sm"
    ><span class="sm:hidden">MHN</span><span class="hidden sm:inline"
      >Mark Hugh Neri</span
    ><span class="sr-only"> — home</span></a
  >

  <ul class="flex items-center">
    {
      links.map((link) => (
        <li>
          <a
            href={link.href}
            class="nav-underline flex h-11 min-w-11 items-center justify-center rounded px-xs font-mono text-label-sm text-ink-muted uppercase transition-colors hover:text-ink-navy motion-reduce:transition-none sm:px-sm"
          >
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

{
  /*
    The scroll rail, directly under the bar.

    BRAND §7 put it at the base of the left rail on desktop and made it a 2px
    top bar on mobile. With no left rail there is only one place it can live, so
    the `bar` variant now serves every width — which is what the mobile
    treatment always was.
  */
}
<div class="sticky top-14 z-20">
  <ScrollRail variant="bar" />
</div>

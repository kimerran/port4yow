---
import { actions } from "astro:actions";
import AdminLayout from "../../layouts/AdminLayout.astro";
import Button from "../../components/Button.astro";
import { assertAdmin } from "../../lib/admin";
import { SETTING_DEFINITIONS, listSettings } from "../../lib/settings";

/**
 * `GET /admin/settings` — the public copy the admin can edit (SPEC §6, #31).
 *
 * One form per setting, and since #82 **one action per setting** too. A single
 * form for everything would discard the valid edits whenever one field failed,
 * and every field here has a different rule.
 *
 * ## Why four actions rather than one
 *
 * `Astro.getActionResult` returns one result per action with no record of which
 * input produced it. With four forms bound to a single `saveSetting`, a thrown
 * error rendered under all four fields — so that action returned
 * `{ ok: false, key, message }` instead of throwing, and a domain refusal
 * answered **HTTP 200**.
 *
 * Splitting it (#82) makes attribution structural: each form has its own
 * result, so the message lands under the field it concerns because it cannot
 * land anywhere else. No key threading, no `ok` flag, and a refusal is a 400
 * like every other action in this codebase.
 */
assertAdmin(Astro.locals);

/**
 * The action each setting posts to.
 *
 * This mapping lives here rather than in `SETTING_DEFINITIONS` because
 * `src/lib/settings.ts` must not import `astro:actions` — it is a virtual
 * module only Astro's build resolves, and the library is imported by tests that
 * run outside it.
 */
const ACTION_FOR = {
  "hero.thesis": actions.saveHeroThesis,
  "about.body": actions.saveAboutBody,
  "social.github": actions.saveGithubUrl,
  "social.linkedin": actions.saveLinkedinUrl,
} as const;

const RESULT_FOR = {
  "hero.thesis": Astro.getActionResult(actions.saveHeroThesis),
  "about.body": Astro.getActionResult(actions.saveAboutBody),
  "social.github": Astro.getActionResult(actions.saveGithubUrl),
  "social.linkedin": Astro.getActionResult(actions.saveLinkedinUrl),
} as const;

const values = await listSettings();

const field =
  "min-h-11 w-full rounded border border-outline-variant bg-surface-raised px-md py-sm text-body-md text-ink-navy";
const label = "font-mono text-label-sm text-ink-muted";
---

<AdminLayout title="Settings — admin" heading="Settings">
  <p class="max-w-[66ch] text-body-md text-ink-muted">
    {
      /*
        BRAND §8 lives where the copy is typed, not in a document nobody opens
        while typing. The rejected phrases are named because a rule with
        examples is followed and a rule without them is argued with.
      */
    }
    Plain, specific, slightly dry. Precision is the personality. No “passionate about”,
    no “crafting digital experiences”, no “let’s build something amazing”.
  </p>

  {
    SETTING_DEFINITIONS.map((definition) => {
      const current = values[definition.key] ?? "";
      const key = definition.key as keyof typeof ACTION_FOR;
      const result = RESULT_FOR[key];
      const failureMessage = result?.error?.message ?? null;
      const errored = failureMessage !== null;
      const saved = result?.data?.ok === true;

      return (
        <section class="flex max-w-[720px] flex-col gap-md">
          <h2 class="font-mono text-label-sm tracking-wide text-ink-muted uppercase">
            {definition.label}
          </h2>

          <form
            method="POST"
            action={ACTION_FOR[key]}
            class="flex flex-col gap-xs"
          >
            <label class="sr-only" for={`s-${definition.key}`}>
              {definition.label}
            </label>

            {definition.rows > 1 ? (
              <textarea
                id={`s-${definition.key}`}
                name="value"
                rows={definition.rows}
                maxlength={definition.maxLength}
                class:list={[field, "resize-y", errored && "border-error"]}
                aria-describedby={`h-${definition.key}`}
                aria-invalid={errored ? "true" : undefined}
              >
                {current}
              </textarea>
            ) : (
              <input
                id={`s-${definition.key}`}
                name="value"
                type="text"
                maxlength={definition.maxLength}
                value={current}
                class:list={[field, errored && "border-error"]}
                aria-describedby={`h-${definition.key}`}
                aria-invalid={errored ? "true" : undefined}
              />
            )}

            <p id={`h-${definition.key}`} class={label}>
              {definition.help} Up to {definition.maxLength} characters.
            </p>

            {errored && (
              <p
                class="text-[14px] text-error"
                role="status"
                aria-live="polite"
              >
                {failureMessage}
              </p>
            )}

            {saved && (
              <p
                class="text-[14px] text-ink-muted"
                role="status"
                aria-live="polite"
              >
                Saved.
              </p>
            )}

            <div>
              <Button type="submit" variant="secondary">
                Save {definition.label.toLowerCase()}
              </Button>
            </div>
          </form>
        </section>
      );
    })
  }
</AdminLayout>

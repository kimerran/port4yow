---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { assertAdmin } from "../../../lib/admin";
import {
  MESSAGE_STATUSES,
  isUndelivered,
  listMessages,
  statusCounts,
} from "../../../lib/messages";

/**
 * `GET /admin/messages` — the inbox (SPEC §6, §7, #30).
 *
 * Filtering is a link, not a form: a filtered inbox is a place you can be, so it
 * deserves a URL you can bookmark, share and go back to. It also means the whole
 * screen works with no client script at all.
 */
assertAdmin(Astro.locals);

const requested = Astro.url.searchParams.get("status");
const status = MESSAGE_STATUSES.find((value) => value === requested);

const [messages, counts] = await Promise.all([
  listMessages(status ? { status } : {}),
  statusCounts(),
]);

const filters = [
  { label: "All", value: null, count: counts.all },
  { label: "New", value: "NEW", count: counts.NEW },
  { label: "Read", value: "READ", count: counts.READ },
  { label: "Replied", value: "REPLIED", count: counts.REPLIED },
  { label: "Spam", value: "SPAM", count: counts.SPAM },
];

const dateFormat = new Intl.DateTimeFormat("en-GB", {
  dateStyle: "medium",
  timeStyle: "short",
  timeZone: "UTC",
});

/** A one-line preview. The full body lives on the detail page. */
const preview = (body: string): string =>
  body.length > 120 ? `${body.slice(0, 120)}…` : body;
---

<AdminLayout title="Messages — admin" heading="Messages">
  {
    counts.undelivered > 0 && (
      /*
        SPEC §7.7 — #22 answers 200 even when the send fails, so this is the only
        place a failed send becomes visible to a human. It goes at the top,
        before the filters, because it is the one thing on this screen that needs
        acting on.
      */
      <p class="rounded-lg border border-error bg-error-container p-md text-body-md">
        {counts.undelivered === 1
          ? "One message was saved but never emailed. It is marked below."
          : `${String(counts.undelivered)} messages were saved but never emailed. They are marked below.`}
      </p>
    )
  }

  <nav aria-label="Filter by status" class="flex flex-wrap gap-xs">
    {
      filters.map((filter) => {
        const href = filter.value
          ? `/admin/messages?status=${filter.value}`
          : "/admin/messages";
        const current = (status ?? null) === filter.value;
        return (
          <a
            href={href}
            aria-current={current ? "page" : undefined}
            class:list={[
              "flex min-h-11 items-center rounded px-sm font-mono text-label-sm",
              current ? "bg-deep-teal/10 text-deep-teal" : "text-ink-muted",
            ]}
          >
            {filter.label} ({filter.count})
          </a>
        );
      })
    }
  </nav>

  {
    messages.length === 0 ? (
      /* BRAND §8 — an invitation, not an apology. */
      <p class="text-body-lg text-ink-muted">
        {status ? `No ${status.toLowerCase()} messages.` : "No messages yet."}
      </p>
    ) : (
      <ul class="flex flex-col gap-sm">
        {messages.map((message) => (
          <li class="flex flex-col gap-xs rounded-lg border border-deep-teal/15 bg-card-face p-md card-shadow">
            <a
              href={`/admin/messages/${message.id}`}
              class="flex flex-col gap-xs"
            >
              <span class="flex flex-wrap items-baseline gap-md">
                {/*
                  Astro escapes an expression by default, and this file never
                  uses set:html — a body of "<script>alert(1)</script>" renders
                  as those characters, not as markup.
                */}
                <span class="font-display text-headline-md">
                  {message.name}
                </span>
                <span class="font-mono text-label-sm text-ink-muted">
                  {message.status.toLowerCase()}
                </span>
                {isUndelivered(message) && (
                  <span class="font-mono text-label-sm text-error">
                    undelivered
                  </span>
                )}
              </span>
              <span class="text-body-md text-ink-muted">
                {preview(message.message)}
              </span>
              <span class="font-mono text-label-sm text-ink-muted">
                {dateFormat.format(message.createdAt)} UTC
              </span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</AdminLayout>

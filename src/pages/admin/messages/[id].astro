---
import { actions } from "astro:actions";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import Button from "../../../components/Button.astro";
import { assertAdmin } from "../../../lib/admin";
import {
  MESSAGE_STATUSES,
  getMessage,
  isUndelivered,
} from "../../../lib/messages";

/**
 * `GET /admin/messages/[id]` — one message (SPEC §6, §7, #30).
 *
 * Read and triage only. There is no edit and no delete: a stored submission is
 * a record of something a person sent, and the inbox is not the place to rewrite
 * it.
 */
assertAdmin(Astro.locals);

const { id } = Astro.params;
const message = id ? await getMessage(id) : null;
if (!message) return Astro.rewrite("/404");

const result = Astro.getActionResult(actions.setMessageStatus);

const dateFormat = new Intl.DateTimeFormat("en-GB", {
  dateStyle: "full",
  timeStyle: "short",
  timeZone: "UTC",
});

const undelivered = isUndelivered(message);
---

<AdminLayout title={`${message.name} — messages`} heading={message.name}>
  <p class="text-[14px] text-error" role="status" aria-live="polite">
    {result?.error?.message}
  </p>

  {
    undelivered && (
      <p class="rounded-lg border border-error bg-error-container p-md text-body-md">
        This message was saved but never emailed. Nothing was lost — it is here
        — but the notification did not arrive, so replying is on you rather than
        on the inbox it should have reached.
      </p>
    )
  }

  <dl class="flex flex-wrap gap-lg">
    <div class="flex flex-col gap-xs">
      <dt class="font-mono text-label-sm text-ink-muted">From</dt>
      <dd class="text-body-md">
        {
          /* mailto is the whole point of the form; the address is the reply-to. */
        }
        <a
          class="text-deep-teal underline underline-offset-4"
          href={`mailto:${message.email}`}
        >
          {message.email}
        </a>
      </dd>
    </div>

    <div class="flex flex-col gap-xs">
      <dt class="font-mono text-label-sm text-ink-muted">Received</dt>
      <dd class="text-body-md">{dateFormat.format(message.createdAt)} UTC</dd>
    </div>

    <div class="flex flex-col gap-xs">
      <dt class="font-mono text-label-sm text-ink-muted">Status</dt>
      <dd class="text-body-md">{message.status.toLowerCase()}</dd>
    </div>

    <div class="flex flex-col gap-xs">
      <dt class="font-mono text-label-sm text-ink-muted">Delivery</dt>
      <dd class="text-body-md">
        {
          message.deliveredAt
            ? `sent ${dateFormat.format(message.deliveredAt)} UTC`
            : message.status === "SPAM"
              ? "not sent — spam"
              : "never sent"
        }
      </dd>
    </div>
  </dl>

  <section class="flex flex-col gap-md">
    <h2 class="font-mono text-label-sm tracking-wide text-ink-muted uppercase">
      Message
    </h2>
    {
      /*
        `whitespace-pre-line` keeps the sender's line breaks without turning
        anything into markup. Astro escapes this expression by default and this
        file never uses set:html — AGENT §3 puts set:html on unsanitised input on
        the must-never-appear list, and a contact body is the definition of
        untrusted input.
      */
    }
    <p class="max-w-[66ch] text-body-md whitespace-pre-line">
      {message.message}
    </p>
  </section>

  <section class="flex flex-col gap-md">
    <h2 class="font-mono text-label-sm tracking-wide text-ink-muted uppercase">
      Triage
    </h2>
    <div class="flex flex-wrap gap-xs">
      {
        MESSAGE_STATUSES.filter((value) => value !== message.status).map(
          (value) => (
            <form method="POST" action={actions.setMessageStatus}>
              <input type="hidden" name="id" value={message.id} />
              <input type="hidden" name="status" value={value} />
              <Button type="submit" variant="secondary">
                Mark {value.toLowerCase()}
              </Button>
            </form>
          ),
        )
      }
    </div>
  </section>

  <a class="text-deep-teal underline underline-offset-4" href="/admin/messages">
    Back to the inbox
  </a>
</AdminLayout>

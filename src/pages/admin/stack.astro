---
import { actions } from "astro:actions";
import AdminLayout from "../../layouts/AdminLayout.astro";
import Button from "../../components/Button.astro";
import { assertAdmin } from "../../lib/admin";
import { db } from "../../lib/db";
import { SUITS, SUIT_CATEGORY, suitFromEnum } from "../../lib/suits";

/**
 * `GET /admin/stack` — StackItem CRUD (SPEC §6, BRAND §6, #29).
 *
 * Grouped by suit, in the BRAND §6 order, because a stack item carries exactly
 * one suit and ordering is only meaningful within one. Every form posts straight
 * to an Action, so the whole page works with JavaScript disabled — the
 * enhancement script only reorders the DOM and rewrites hidden inputs.
 */
assertAdmin(Astro.locals);

const createResult = Astro.getActionResult(actions.createStackItem);
const updateResult = Astro.getActionResult(actions.updateStackItem);
const deleteResult = Astro.getActionResult(actions.deleteStackItem);
const reorderResult = Astro.getActionResult(actions.reorderStackItems);

const errorMessage =
  createResult?.error?.message ??
  updateResult?.error?.message ??
  deleteResult?.error?.message ??
  reorderResult?.error?.message ??
  null;

const items = await db.stackItem.findMany({
  orderBy: [{ suit: "asc" }, { sortOrder: "asc" }],
  select: {
    id: true,
    name: true,
    suit: true,
    sortOrder: true,
    featured: true,
    _count: { select: { projects: true } },
  },
});

const bySuit = SUITS.map((suit) => ({
  suit,
  enumValue: suit.toUpperCase(),
  category: SUIT_CATEGORY[suit],
  items: items.filter((item) => suitFromEnum(item.suit) === suit),
}));

const field =
  "min-h-11 w-full rounded border border-outline-variant bg-surface-raised px-md py-sm text-body-md text-ink-navy";
const label = "font-mono text-label-sm text-ink-muted";
---

<AdminLayout title="Stack — admin" heading="Stack">
  <p class="text-[14px] text-error" role="status" aria-live="polite">
    {errorMessage}
  </p>

  <section class="flex flex-col gap-md">
    <h2 class="font-mono text-label-sm tracking-wide text-ink-muted uppercase">
      Add an item
    </h2>

    <form
      method="POST"
      action={actions.createStackItem}
      class="flex max-w-[560px] flex-col gap-lg"
    >
      <div class="flex flex-col gap-xs">
        <label class={label} for="s-name">Name</label>
        <input
          id="s-name"
          name="name"
          type="text"
          required
          maxlength="60"
          class={field}
        />
      </div>

      <div class="flex flex-col gap-xs">
        <label class={label} for="s-suit">Suit</label>
        <select id="s-suit" name="suit" class={field}>
          {
            SUITS.map((suit) => (
              <option value={suit.toUpperCase()}>{SUIT_CATEGORY[suit]}</option>
            ))
          }
        </select>
      </div>

      <label class="flex min-h-11 items-center gap-xs text-body-md">
        <input type="checkbox" name="featured" value="true" />
        Featured
      </label>

      <div>
        <Button type="submit">Add</Button>
      </div>
    </form>
  </section>

  {
    bySuit.map((group) => (
      <section class="flex flex-col gap-md">
        <h2 class="font-display text-headline-md">{group.category}</h2>

        {group.items.length === 0 ? (
          /* BRAND §8 — an invitation, not an apology. */
          <p class="text-body-md text-ink-muted">
            Nothing here yet. Add the first one above.
          </p>
        ) : (
          <>
            <p
              class="text-body-md"
              data-reorder-status
              role="status"
              aria-live="polite"
            />

            <ol
              class="flex flex-col gap-sm"
              data-reorder-list={group.enumValue}
            >
              {group.items.map((item, index) => (
                <li
                  class="flex flex-wrap items-center gap-md rounded-lg border border-deep-teal/15 bg-surface-raised p-md panel-shadow"
                  data-item-id={item.id}
                >
                  <form
                    method="POST"
                    action={actions.updateStackItem}
                    class="flex flex-wrap items-center gap-md"
                  >
                    <input type="hidden" name="id" value={item.id} />

                    <label class="sr-only" for={`n-${item.id}`}>
                      Name
                    </label>
                    <input
                      id={`n-${item.id}`}
                      name="name"
                      type="text"
                      required
                      maxlength="60"
                      class={`${field} max-w-[220px]`}
                      value={item.name}
                    />

                    <label class="sr-only" for={`u-${item.id}`}>
                      Suit for {item.name}
                    </label>
                    <select
                      id={`u-${item.id}`}
                      name="suit"
                      class={`${field} max-w-[220px]`}
                    >
                      {SUITS.map((suit) => (
                        <option
                          value={suit.toUpperCase()}
                          selected={suitFromEnum(item.suit) === suit}
                        >
                          {SUIT_CATEGORY[suit]}
                        </option>
                      ))}
                    </select>

                    <label class="flex min-h-11 items-center gap-xs text-body-md">
                      <input
                        type="checkbox"
                        name="featured"
                        value="true"
                        checked={item.featured}
                      />
                      Featured
                    </label>

                    <Button type="submit" variant="secondary">
                      Save
                    </Button>
                  </form>

                  <span class="font-mono text-label-sm text-ink-muted">
                    {item._count.projects === 0
                      ? "unused"
                      : `used by ${item._count.projects}`}
                  </span>

                  {/*
                    BRAND §9 — ordering must be keyboard-operable, so these
                    buttons are the primary control and drag is the extra.
                  */}
                  <span class="ml-auto flex items-center gap-xs">
                    <button
                      type="button"
                      data-move="up"
                      disabled={index === 0}
                      aria-label={`Move ${item.name} up`}
                      class="flex h-11 min-w-11 items-center justify-center rounded border border-deep-teal/20 font-mono text-label-sm disabled:text-ink-muted"
                    >
                      ↑
                    </button>
                    <button
                      type="button"
                      data-move="down"
                      disabled={index === group.items.length - 1}
                      aria-label={`Move ${item.name} down`}
                      class="flex h-11 min-w-11 items-center justify-center rounded border border-deep-teal/20 font-mono text-label-sm disabled:text-ink-muted"
                    >
                      ↓
                    </button>
                  </span>

                  {/*
                    The impact is in the BUTTON, not behind a second click.
                    #29 asks for the count to be surfaced before confirming, and
                    a label saying what will happen is a better confirmation than
                    a dialog nobody reads. `confirmed` rides along because the
                    admin has already been told.

                    The server still refuses an UNconfirmed delete of an in-use
                    item — that guard protects any caller posting without this
                    label in front of them, which is the case a UI-only
                    confirmation misses.
                  */}
                  <form method="POST" action={actions.deleteStackItem}>
                    <input type="hidden" name="id" value={item.id} />
                    {item._count.projects > 0 && (
                      <input type="hidden" name="confirmed" value="true" />
                    )}
                    <Button type="submit" variant="secondary">
                      {item._count.projects === 0
                        ? "Delete"
                        : `Delete — also removes it from ${String(item._count.projects)} project${item._count.projects === 1 ? "" : "s"}`}
                    </Button>
                  </form>
                </li>
              ))}
            </ol>

            <form
              method="POST"
              action={actions.reorderStackItems}
              class="flex gap-md"
            >
              <input type="hidden" name="suit" value={group.enumValue} />
              <span data-ordered-ids={group.enumValue}>
                {group.items.map((item) => (
                  <input type="hidden" name="orderedIds" value={item.id} />
                ))}
              </span>
              <Button type="submit" variant="secondary">
                Save order
              </Button>
            </form>
          </>
        )}
      </section>
    ))
  }
</AdminLayout>

<script>
  import { initListReorder } from "../../scripts/list-reorder.ts";
  initListReorder();
</script>

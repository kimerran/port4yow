---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { assertAdmin, getDashboardStats } from "../../lib/admin";

/**
 * `GET /admin` — the landing screen behind the session guard (SPEC §6, #26).
 *
 * `assertAdmin` runs here even though #24's middleware already redirects an
 * unauthenticated request. SPEC §6 and AGENT §3 both require every handler to
 * re-check server-side, and the cost of being wrong is the whole admin.
 */
const user = assertAdmin(Astro.locals);
const stats = await getDashboardStats(user.id);

const dateFormat = new Intl.DateTimeFormat("en-GB", {
  dateStyle: "medium",
  timeStyle: "short",
  timeZone: "UTC",
});

const cards = [
  {
    label: "Unread messages",
    value: stats.unreadMessages,
    href: "/admin/messages",
    /* BRAND §8 — an empty state is an invitation, never an apology. */
    empty: "No messages yet.",
  },
  {
    label: "Undelivered",
    value: stats.undeliveredMessages,
    href: "/admin/messages",
    empty: "Everything sent.",
  },
  {
    label: "Published projects",
    value: stats.projectsByStatus.published,
    href: "/admin/projects",
    empty: "Nothing published yet.",
  },
  {
    label: "Drafts",
    value: stats.projectsByStatus.draft,
    href: "/admin/projects",
    empty: "No drafts.",
  },
];
---

<AdminLayout title="Dashboard — admin" heading="Dashboard">
  <section class="flex flex-col gap-md">
    <h2 class="font-mono text-label-sm tracking-wide text-ink-muted uppercase">
      At a glance
    </h2>

    <ul class="grid gap-md sm:grid-cols-2 lg:grid-cols-4">
      {
        cards.map((card) => (
          <li>
            <a
              href={card.href}
              class="flex min-h-11 flex-col gap-xs rounded-lg border border-deep-teal/15 bg-surface-raised p-md panel-shadow"
            >
              <span class="font-mono text-label-sm text-ink-muted">
                {card.label}
              </span>
              {card.value > 0 ? (
                <span class="font-display text-headline-lg">{card.value}</span>
              ) : (
                <span class="text-body-md text-ink-muted">{card.empty}</span>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="flex flex-col gap-md">
    <h2 class="font-mono text-label-sm tracking-wide text-ink-muted uppercase">
      Projects by status
    </h2>
    <dl class="flex flex-wrap gap-lg">
      {
        (
          [
            ["Draft", stats.projectsByStatus.draft],
            ["Published", stats.projectsByStatus.published],
            ["Archived", stats.projectsByStatus.archived],
          ] as const
        ).map(([label, count]) => (
          <div class="flex flex-col gap-xs">
            <dt class="font-mono text-label-sm text-ink-muted">{label}</dt>
            <dd class="font-display text-headline-md">{count}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="flex flex-col gap-md">
    <h2 class="font-mono text-label-sm tracking-wide text-ink-muted uppercase">
      Last sign-in
    </h2>
    <p class="text-body-md text-ink-muted">
      {
        stats.lastLoginAt
          ? `${dateFormat.format(stats.lastLoginAt)} UTC`
          : "This is your first sign-in."
      }
    </p>
  </section>
</AdminLayout>

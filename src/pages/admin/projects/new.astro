---
import { actions } from "astro:actions";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import Button from "../../../components/Button.astro";
import { assertAdmin } from "../../../lib/admin";
import { db } from "../../../lib/db";

/**
 * `GET /admin/projects/new` — create form (#27).
 *
 * The form posts straight to the `createProject` Action, which is what makes it
 * work with JavaScript disabled: Astro handles a form POST to an action and
 * redirects back with the result. There is no client script on this page.
 *
 * A new project is always created DRAFT. Publication is a separate, gated step
 * (SPEC §6) — there is no "create and publish".
 */
assertAdmin(Astro.locals);

const result = Astro.getActionResult(actions.createProject);
if (result && !result.error) {
  return Astro.redirect(`/admin/projects/${result.data.id}`, 303);
}

const [stackItems, assets] = await Promise.all([
  db.stackItem.findMany({
    orderBy: { name: "asc" },
    select: { id: true, name: true },
  }),
  db.mediaAsset.findMany({
    orderBy: { createdAt: "desc" },
    take: 100,
    select: { id: true, key: true, altText: true },
  }),
]);

const slugLocked = false;
const values = {
  title: "",
  slug: "",
  suit: "DIAMONDS",
  summary: "",
  role: "",
  timeline: "",
  problem: "",
  body: "",
  outcome: "",
  liveUrl: "",
  repoUrl: "",
  coverImageId: "",
  stackItemIds: [] as string[],
};

const field =
  "min-h-11 w-full rounded border border-outline-variant bg-surface-raised px-md py-sm text-body-md text-ink-navy";
const label = "font-mono text-label-sm text-ink-muted";
---

<AdminLayout title="New project — admin" heading="New project">
  <form
    method="POST"
    action={actions.createProject}
    class="flex max-w-[720px] flex-col gap-lg"
  >
    <p class="text-[14px] text-error" role="status" aria-live="polite">
      {result?.error?.message}
    </p>

    <div class="flex flex-col gap-xs">
      <label class={label} for="f-title">Title</label>
      <input
        id="f-title"
        name="title"
        type="text"
        required
        maxlength="120"
        class={field}
        value={values.title}
      />
    </div>

    <div class="flex flex-col gap-xs">
      <label class={label} for="f-slug">Slug</label>
      <input
        id="f-slug"
        name="slug"
        type="text"
        required
        maxlength="96"
        class={field}
        value={values.slug}
        readonly={slugLocked}
        aria-describedby="f-slug-help"
      />
      <p id="f-slug-help" class="font-mono text-label-sm text-ink-muted">
        {
          slugLocked
            ? "Published — the slug is fixed. Other people have linked to it."
            : "Lowercase words separated by hyphens."
        }
      </p>
    </div>

    <div class="flex flex-col gap-xs">
      <label class={label} for="f-suit">Suit</label>
      <select id="f-suit" name="suit" class={field}>
        {
          ["DIAMONDS", "SPADES", "HEARTS", "CLUBS"].map((suit) => (
            <option value={suit} selected={values.suit === suit}>
              {suit.charAt(0) + suit.slice(1).toLowerCase()}
            </option>
          ))
        }
      </select>
    </div>

    <div class="flex flex-col gap-xs">
      <label class={label} for="f-summary">Summary</label>
      <input
        id="f-summary"
        name="summary"
        type="text"
        maxlength="180"
        class={field}
        value={values.summary}
      />
    </div>

    <div class="flex flex-col gap-xs">
      <label class={label} for="f-role">Role</label>
      <input
        id="f-role"
        name="role"
        type="text"
        maxlength="120"
        class={field}
        value={values.role}
      />
    </div>

    <div class="flex flex-col gap-xs">
      <label class={label} for="f-timeline">Timeline</label>
      <input
        id="f-timeline"
        name="timeline"
        type="text"
        maxlength="120"
        class={field}
        value={values.timeline}
      />
    </div>

    <div class="flex flex-col gap-xs">
      <label class={label} for="f-problem">Problem</label>
      <textarea
        id="f-problem"
        name="problem"
        rows="4"
        maxlength="5000"
        class={`${field} resize-y`}>{values.problem}</textarea
      >
    </div>

    <div class="flex flex-col gap-xs">
      <label class={label} for="f-body">Body (Markdown)</label>
      <textarea
        id="f-body"
        name="body"
        rows="12"
        maxlength="50000"
        class={`${field} resize-y font-mono`}>{values.body}</textarea
      >
    </div>

    <div class="flex flex-col gap-xs">
      <label class={label} for="f-outcome">Outcome</label>
      <textarea
        id="f-outcome"
        name="outcome"
        rows="4"
        maxlength="5000"
        class={`${field} resize-y`}>{values.outcome}</textarea
      >
    </div>

    <div class="flex flex-col gap-xs">
      <label class={label} for="f-live">Live URL</label>
      <input
        id="f-live"
        name="liveUrl"
        type="url"
        maxlength="512"
        class={field}
        value={values.liveUrl}
      />
    </div>

    <div class="flex flex-col gap-xs">
      <label class={label} for="f-repo">Repository URL</label>
      <input
        id="f-repo"
        name="repoUrl"
        type="url"
        maxlength="512"
        class={field}
        value={values.repoUrl}
      />
    </div>

    <div class="flex flex-col gap-xs">
      <label class={label} for="f-cover">Cover image</label>
      <select id="f-cover" name="coverImageId" class={field}>
        <option value="">No cover</option>
        {
          assets.map((asset) => (
            <option
              value={asset.id}
              selected={values.coverImageId === asset.id}
            >
              {asset.key}{" "}
              {asset.altText.trim().length === 0 ? "(no alt text)" : ""}
            </option>
          ))
        }
      </select>
    </div>

    <fieldset class="flex flex-col gap-xs">
      <legend class={label}>Stack</legend>
      {
        stackItems.length === 0 ? (
          <p class="text-body-md text-ink-muted">No stack items yet.</p>
        ) : (
          <div class="flex flex-wrap gap-md">
            {stackItems.map((item) => (
              <label class="flex min-h-11 items-center gap-xs text-body-md">
                <input
                  type="checkbox"
                  name="stackItemIds"
                  value={item.id}
                  checked={values.stackItemIds.includes(item.id)}
                />
                {item.name}
              </label>
            ))}
          </div>
        )
      }
    </fieldset>

    <div>
      <Button type="submit">Create draft</Button>
    </div>
  </form>
</AdminLayout>

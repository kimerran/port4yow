---
import Card from "../../components/Card.astro";
import JsonLd from "../../components/JsonLd.astro";
import ResponsiveImage from "../../components/ResponsiveImage.astro";
import SuitGlyph from "../../components/SuitGlyph.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedProject } from "../../lib/project";
import { SUIT_CATEGORY } from "../../lib/suits";

const { slug } = Astro.params;
const project = slug ? await getPublishedProject(slug) : null;

/* SPEC §5 — unknown OR non-PUBLISHED slug returns 404. Never a 500, and never a
   redirect that would leak whether the row exists. The status filter lives in the
   WHERE clause, so a DRAFT row is indistinguishable from one that never was. */
if (!project) {
  return new Response(null, { status: 404 });
}

Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=0, s-maxage=300, stale-while-revalidate=86400",
);

const index = String(project.sequence).padStart(2, "0");
const canonical = new URL(`/work/${project.slug}`, Astro.site ?? Astro.url)
  .href;

/* SPEC §5 — article JSON-LD. The set:html exception and the `<` escaping that
   makes it safe both live in JsonLd.astro, so this file never touches raw HTML. */

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: project.title,
  description: project.summary,
  url: canonical,
  author: { "@type": "Person", name: "Mark Hugh Neri" },
  ...(project.publishedAt
    ? { datePublished: project.publishedAt.toISOString() }
    : {}),
};
---

<BaseLayout
  title={`${project.title} — Mark Hugh Neri`}
  description={project.summary}
  canonical={canonical}
>
  <JsonLd data={jsonLd} />

  <article class="flex flex-col gap-2xl py-2xl">
    {
      /* 1 · Hero — the tile enlarged, keeping its index and suit so the card
        carries over from the grid (SPEC §5). */
    }
    <header class="flex flex-col gap-lg lg:flex-row lg:items-start lg:gap-2xl">
      <div class="w-[280px] shrink-0">
        <Card class="flex flex-col justify-between p-md">
          <span
            class="font-mono text-index-rank text-metallic-gold"
            aria-hidden="true">{index}</span
          >
          <span
            class="rotate-180 self-end text-metallic-gold"
            aria-hidden="true"
          >
            <SuitGlyph suit={project.suit} />
          </span>
        </Card>
      </div>

      <div class="flex min-w-0 flex-col gap-md">
        {/* One of only four places the display face appears (BRAND §3). */}
        {
          /* break-words because `headline-lg` has no responsive step the way BRAND §3
            gives display-xl (96/56/44), and the content is an arbitrary
            admin-entered title. "reconciliation" alone needs 317px at 48px Bodoni
            and overflows a 320px viewport by 13px — measured. overflow-wrap only
            engages when a word genuinely cannot fit, so wider layouts are
            unaffected. */
        }
        <h1 class="font-display text-headline-lg break-words">
          {project.title}
        </h1>
        <p class="max-w-[66ch] text-body-lg text-ink-muted">
          {project.summary}
        </p>

        {
          /* 2 · Metadata strip — mono label-sm, ink-muted, gold middot separators,
            wrapping to two lines on mobile (BRAND §7). */
        }
        <ul
          class="flex flex-wrap items-center gap-x-sm gap-y-xs font-mono text-label-sm text-ink-muted uppercase"
        >
          <li>{project.role}</li>
          <li aria-hidden="true" class="text-metallic-gold">·</li>
          <li>{project.timeline}</li>
          <li aria-hidden="true" class="text-metallic-gold">·</li>
          <li>
            <span class="sr-only">Category: </span>{SUIT_CATEGORY[project.suit]}
          </li>
          {
            project.stack.map((item) => (
              <>
                <li aria-hidden="true" class="text-metallic-gold">
                  ·
                </li>
                <li>{item}</li>
              </>
            ))
          }
        </ul>
      </div>
    </header>

    {/* 3 · The problem */}
    <section class="flex flex-col gap-md">
      <h2 class="font-display text-headline-md">The problem</h2>
      <p class="max-w-[66ch] text-body-lg text-ink-muted">{project.problem}</p>
    </section>

    {
      /* 4 · What I built — Markdown rendering is #16. Until it lands the body is
        plain text, which Astro escapes by default and never reaches set:html. */
    }
    <section class="flex flex-col gap-md">
      <h2 class="font-display text-headline-md">What I built</h2>
      <p class="max-w-[66ch] text-body-md whitespace-pre-line text-ink-muted">
        {project.body}
      </p>
    </section>

    {
      /* Inline screenshots (SPEC §5 block 4). Every derivative that EXISTS is
        offered — see src/lib/images.ts for why they cannot be guessed from the
        key. The first is eager: it is the first thing below the fold. */
    }
    {
      project.images.length > 0 && (
        <div class="flex flex-col gap-lg">
          {project.images.map((image, i) => (
            <ResponsiveImage
              assets={image.assets}
              caption={image.caption}
              eager={i === 0}
            />
          ))}
        </div>
      )
    }

    {/* 5 · Outcome */}
    <section class="flex flex-col gap-md">
      <h2 class="font-display text-headline-md">Outcome</h2>
      <p class="max-w-[66ch] text-body-lg text-ink-muted">{project.outcome}</p>
    </section>

    {/* 6 · Links */}
    {
      (project.liveUrl || project.repoUrl) && (
        <section class="flex flex-col gap-md">
          <h2 class="font-display text-headline-md">Links</h2>
          <ul class="flex flex-wrap gap-lg">
            {project.liveUrl && (
              <li>
                <a
                  class="text-deep-teal underline underline-offset-4"
                  href={project.liveUrl}
                  rel="noopener noreferrer"
                >
                  Live site
                </a>
              </li>
            )}
            {project.repoUrl && (
              <li>
                <a
                  class="text-deep-teal underline underline-offset-4"
                  href={project.repoUrl}
                  rel="noopener noreferrer"
                >
                  Repository
                </a>
              </li>
            )}
          </ul>
        </section>
      )
    }

    {/* 7 · Next card — #18. */}
  </article>
</BaseLayout>

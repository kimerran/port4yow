---
import { getImage, Image } from "astro:assets";
import { render } from "astro:content";
import JsonLd from "../../components/JsonLd.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import RelatedProjects from "../../components/RelatedProjects.astro";
import type { Project } from "../../lib/content";
import { indexOf, listProjects } from "../../lib/content";

/**
 * SPEC §5 — one page per project, prerendered.
 *
 * This used to be a server route that queried Postgres for a PUBLISHED row and
 * rewrote to /404 when it found nothing. With projects as files there is no
 * unknown slug to handle: `getStaticPaths` enumerates exactly the pages that
 * exist, so anything else is a genuine 404 from the adapter, and a draft simply
 * has no page built for it — indistinguishable from one that never existed,
 * which is the property the old status filter was there to guarantee.
 */
export async function getStaticPaths() {
  const projects = await listProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project, projects },
  }));
}

/**
 * Astro infers nothing about `Astro.props` from `getStaticPaths`, so without
 * this every access below is `any` — which the type-aware lint rules correctly
 * refuse (`no-unsafe-member-access`). Declaring `Props` is what makes the page
 * type-checked against the collection schema.
 */
interface Props {
  project: Project;
  projects: Project[];
}

const { project, projects } = Astro.props;
const { data } = project;

/* Markdown from the file, rendered by Astro. `lib/markdown.ts` and its
   sanitizer are gone with it: the content is authored in this repository and
   reviewed in a diff, so it is trusted input in a way admin-submitted Markdown
   never was. */
const { Content } = await render(project);

/* Everything except the page you are on. `RelatedProjects` picks three of these
   in the browser — see that component for why the choice is not made here. */
const others = projects.filter((p) => p.id !== project.id);
const canonical = new URL(`/work/${project.id}`, Astro.site ?? Astro.url).href;

/**
 * #34 — a per-project OG image, generated at 1200x630.
 *
 * It used to point at the cover asset directly, which is whatever shape the
 * screenshot happened to be — 1600x660 for one project, 1193x2046 for another.
 * A portrait OG image is cropped unpredictably by every scraper, and it made the
 * `og:image:width/height` tags in BaseLayout impossible to state truthfully.
 *
 * `fit: "cover"` crops rather than squashing, anchored to the top: a screenshot's
 * subject is its header, and centre-cropping a tall dashboard yields a band of
 * empty table body.
 */
const ogAsset = await getImage({
  src: data.cover,
  width: 1200,
  height: 630,
  format: "jpeg",
  fit: "cover",
  position: "top",
});
const ogImage = new URL(ogAsset.src, Astro.site ?? Astro.url).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: data.title,
  description: data.summary,
  url: canonical,
  author: { "@type": "Person", name: "Mark Hugh Neri" },
  image: ogImage,
};
---

<BaseLayout
  title={`${data.title} — Mark Hugh Neri`}
  description={data.summary}
  canonical={canonical}
  ogImage={ogImage}
  ogImageAlt={data.coverAlt}
  ogType="article"
>
  <JsonLd data={jsonLd} />

  <article class="flex flex-col gap-xl py-xl sm:gap-2xl sm:py-2xl">
    {/* 1 · Hero */}
    <header class="flex flex-col gap-lg">
      <div class="flex min-w-0 flex-col gap-md">
        <span
          class="font-mono text-index-rank text-metallic-gold"
          aria-hidden="true">{indexOf(project)}</span
        >
        {/* One of only four places the display face appears (BRAND §3). */}
        {
          /* break-words because `headline-lg` has no responsive step the way BRAND §3
            gives display-xl (96/56/44), and the content is an arbitrary title. */
        }
        <h1 class="font-display text-headline-lg break-words">{data.title}</h1>
        <p class="max-w-[66ch] text-body-lg text-ink-muted">{data.tagline}</p>

        {
          /* 2 · Metadata.

            BRAND §7 specifies a "metadata strip … items separated by a gold
            middot, wrapping to two lines on mobile". It wrote that for a handful
            of items. These projects carry up to 30: as a middot run-on, BlockHub
            filled NINE lines at 375px and pushed the screenshot off the first
            screen entirely — measured. The two-line intent is the part worth
            keeping, so the stack is chips, which wrap into a scannable block
            instead of one uppercase paragraph.

            `role` and `timeline` used to lead this strip. They are not in the
            source material these projects were written from, and AGENT §6
            forbids inventing them. */
        }
        <div class="flex flex-wrap items-center gap-sm">
          <p class="font-mono text-label-sm text-ink-muted uppercase">
            <span class="sr-only">Category: </span>{data.category}
          </p>
          {
            /* The same badge the grid tile carries. Not strictly asked for, but
              a claim that appears on the card and then vanishes on the page the
              card links to reads as a mistake. */
            data.badge && (
              <span
                class:list={[
                  "rounded px-sm py-xs font-mono text-label-sm uppercase",
                  data.badge === "Hackathon Winner"
                    ? "bg-deep-teal text-cool-stock"
                    : "border border-outline-variant text-ink-muted",
                ]}
              >
                {data.badge}
              </span>
            )
          }
        </div>

        {
          /* The primary call to action, at the top.

            A project page's job is to get someone to the thing itself; burying
            that link under the whole write-up meant it was reached only by
            people who had already scrolled past everything. Styled as a filled
            button rather than an underlined link so it reads as the action on
            the page, not as one more reference. */
        }
        {
          data.liveUrl && (
            <p>
              <a
                href={data.liveUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-11 items-center gap-sm rounded-lg bg-deep-teal px-lg py-sm font-mono text-label-sm text-cool-stock uppercase transition-colors hover:bg-ink-navy focus-visible:bg-ink-navy motion-reduce:transition-none"
              >
                Visit the live site
                <span class="sr-only">(opens in a new tab)</span>
                <span aria-hidden="true">↗</span>
              </a>
            </p>
          )
        }

        <ul class="flex flex-wrap gap-xs">
          <li class="sr-only">Built with:</li>
          {
            data.stack.map((item) => (
              <li class="rounded border border-outline-variant px-sm py-xs font-mono text-label-sm text-ink-muted uppercase">
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </header>

    {/* 3 · The screenshot, full width under the header. */}
    <figure class="flex flex-col gap-sm reveal">
      <div
        class="overflow-hidden rounded-lg border border-outline-variant bg-surface-sunken"
      >
        {
          /* `alt=""`, deliberately. The figcaption below carries exactly this
            text and is already in the accessibility tree, so a matching `alt`
            makes a screen reader read the same sentence twice in a row. The
            standard pattern for an image whose visible caption describes it is
            to mark the image decorative and let the caption speak. The grid tile
            is the opposite case — no caption there, so it keeps the alt. */
        }
        <Image
          src={data.cover}
          alt=""
          widths={[480, 960, 1440]}
          sizes="(min-width: 1280px) 1280px, 100vw"
          loading="eager"
          class="h-auto w-full"
        />
      </div>
      <figcaption class="text-body-md text-ink-muted">
        {data.coverAlt}
      </figcaption>
    </figure>

    {/* 4 · The write-up, straight from the Markdown body. */}
    <section class="prose-body flex max-w-[66ch] flex-col gap-md reveal">
      <Content />
    </section>

    {
      /* 5 · Repository, and the NDA note.

        The live-site link moved to the top of the page as a CTA — see the
        header. It was the single most useful thing on the page and it was
        sitting below a 2,000-word write-up, which is the wrong end. */
    }
    {
      (data.repoUrl || data.whiteLabel) && (
        <section class="flex flex-col gap-md">
          <h2 class="font-display text-headline-md">Links</h2>
          {data.whiteLabel ? (
            /* Say why there is no link. A conspicuous gap invites the question
               this sentence answers. */
            <p class="max-w-[66ch] text-body-md text-ink-muted">
              Built under NDA, so the client and the deployment are not named.
            </p>
          ) : (
            <ul class="flex flex-wrap gap-lg">
              {data.repoUrl && (
                <li>
                  <a
                    class="inline-flex min-h-11 items-center gap-xs text-deep-teal underline underline-offset-4"
                    href={data.repoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Repository
                    <span class="sr-only">(opens in a new tab)</span>
                    <span aria-hidden="true">↗</span>
                  </a>
                </li>
              )}
            </ul>
          )}
        </section>
      )
    }

    {
      /* 6 · More projects. Omitted when this is the only one.

        This replaced a single "Next project" link that walked a fixed chain by
        `sequence` — from any given project you always reached the same one, and
        project 14 was the only route back to project 1. */
    }
    <RelatedProjects others={others} />

    <script>
      import { initReveal } from "../../scripts/reveal.ts";
      initReveal();
    </script>
  </article>
</BaseLayout>

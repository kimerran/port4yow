---
import { Font } from "astro:assets";
import FacetLattice from "../components/FacetLattice.astro";
import SiteNav from "../components/SiteNav.astro";
import ogDefault from "../assets/og-default.jpg";
import { social } from "../site.config";
import "../styles/global.css";

/**
 * The shell every public page renders into (SPEC §5, BRAND §4/§7).
 *
 * The <Font> tags below are load-bearing: Astro's `fonts` config in
 * astro.config.mjs downloads and self-hosts the files, but emits NO @font-face
 * unless this component renders in <head> (#9's handoff). Only the display face
 * is preloaded — it carries the hero name, the LCP element (SPEC §15).
 */
interface Props {
  title: string;
  description: string;
  /** Absolute URL for canonical + OG. Falls back to the current request URL. */
  canonical?: string | undefined;
  /**
   * `| undefined` explicitly: with `exactOptionalPropertyTypes`, an optional
   * prop and a prop that may be passed as `undefined` are different types, and
   * every caller computing this from nullable data produces the latter.
   */
  ogImage?: string | undefined;
  /** Alt text for the OG image — scrapers surface it, so it is not optional in practice. */
  ogImageAlt?: string | undefined;
  /**
   * `website` for the home page, `article` for a project.
   *
   * It was hardcoded to `website` everywhere, which told every scraper that a
   * project page was a site rather than a piece of writing — and the Article
   * JSON-LD on that same page said otherwise. Two answers to one question is
   * worse than either answer.
   */
  ogType?: "website" | "article";
}

const {
  title,
  description,
  canonical,
  ogImage,
  ogImageAlt,
  ogType = "website",
} = Astro.props;

const canonicalUrl =
  canonical ?? new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
/**
 * Every page gets an OG image, falling back to a generated card.
 *
 * A page without one renders as a bare text link in every social preview, and
 * the home page — the most-shared URL on the site — had none. `og-default.jpg`
 * is a real 1200x630 card built from the brand tokens, not a screenshot of
 * something unrelated.
 */
const ogImageUrl = new URL(ogImage ?? ogDefault.src, Astro.site ?? Astro.url)
  .href;
const ogImageAltText =
  ogImageAlt ?? "Mark Hugh Neri — software engineer, 14+ years.";

/**
 * The footer's outbound links.
 *
 * `rel="me"` alongside `noopener noreferrer`: it is the machine-readable claim
 * that these profiles are the same person as this site, which is what the
 * `sameAs` in the home page's Person JSON-LD asserts in the other direction.
 * The mail link is not external in the tab sense — opening a compose window in
 * a new tab leaves an empty one behind.
 */
const contactLinks = [
  { label: "GitHub", href: social.github, external: true },
  { label: "LinkedIn", href: social.linkedin, external: true },
  { label: "Email", href: social.email, external: false },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <Font cssVariable="--font-bodoni-moda" preload />
    <Font cssVariable="--font-karla" />
    <Font cssVariable="--font-plex-mono" />

    {
      /* #40 — without this every page logs a 404 for /favicon.ico, which
         Lighthouse counts under `errors-in-console` (Best Practices). An SVG
         rather than an .ico: one file, scales to every size, and no binary
         asset to regenerate. */
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    {
      /* Crawling and indexing, stated rather than left to the default.
         `max-image-preview:large` is what lets the OG card render full-width in
         a result rather than as a thumbnail. */
    }
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <meta name="author" content="Mark Hugh Neri" />
    <meta name="theme-color" content="#EDF3F3" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Mark Hugh Neri" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    {
      /* Dimensions let a scraper reserve the space before it has fetched the
         image, which is the difference between a card that renders immediately
         and one that pops in — and some scrapers refuse an image they cannot
         size. Both cards are 1200x630. */
    }
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {
      /* A scraper renders this as the image's description; omitting it makes the
         card an unlabelled picture for anyone using a screen reader on it. */
    }
    <meta property="og:image:alt" content={ogImageAltText} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAltText} />
  </head>

  <body class="min-h-screen bg-cool-stock font-body text-body-md text-ink-navy">
    <FacetLattice />

    {
      /* BRAND §9 — keyboard-operable throughout. First tab stop on every page. */
    }
    <a
      href="#main"
      class="sr-only rounded-lg bg-surface-raised px-md py-sm text-ink-navy focus:not-sr-only focus:absolute focus:top-sm focus:left-sm focus:z-50"
      >Skip to content</a
    >

    <SiteNav />

    {
      /* One of only two client scripts on public pages (SPEC §15).

        A plain <script> is what you want: Astro processes it, hashes it at build
        time, and it runs under CSP. `is:inline` opts out of that processing, is
        never hashed, and is blocked. Astro inlines this module into the page
        rather than emitting a .js file — the separate module exists to make the
        maths testable, not to satisfy CSP. */
    }
    <script>
      import { initScrollRail } from "../scripts/scroll-rail.ts";
      initScrollRail();
    </script>

    {
      /* The nav is a sticky top bar at every width now, so it takes its own
         space in the flow — no padding to clear a fixed rail. */
    }
    <div>
      <main
        id="main"
        class="mx-auto w-full max-w-[1280px] px-md py-xl md:px-lg"
      >
        <slot />
      </main>

      <footer class="mx-auto w-full max-w-[1280px] px-md py-xl md:px-lg">
        {/* Inset to the content column, never full-bleed (BRAND §4). */}
        <div class="flex flex-col gap-lg border-t border-deep-teal/10 pt-lg">
          <nav aria-label="Elsewhere">
            <ul class="flex flex-wrap items-center gap-x-lg gap-y-xs">
              {
                contactLinks.map((link) => (
                  <li>
                    <a
                      class="nav-underline inline-flex min-h-11 min-w-11 items-center justify-center gap-xs font-mono text-label-sm text-ink-muted uppercase transition-colors hover:text-deep-teal focus-visible:text-deep-teal motion-reduce:transition-none"
                      href={link.href}
                      {...(link.external
                        ? {
                            target: "_blank",
                            rel: "noopener noreferrer me",
                          }
                        : {})}
                    >
                      {link.label}
                      {link.external && (
                        <>
                          <span class="sr-only">(opens in a new tab)</span>
                          <span aria-hidden="true">↗</span>
                        </>
                      )}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>

          <p
            class="flex flex-wrap items-center gap-x-md gap-y-sm font-mono text-label-sm text-ink-muted uppercase"
          >
            <span>© {new Date().getFullYear()} Mark Hugh Neri</span>
            {
              /* SPEC §14.10 requires the privacy note to be linked from the
                 footer, and the footer lives here — so it is on every public
                 page by construction rather than by remembering. */
            }
            <a
              class="inline-flex min-h-11 items-center underline underline-offset-4 hover:text-deep-teal focus-visible:text-deep-teal"
              href="/privacy">Privacy</a
            >
          </p>
        </div>
      </footer>
    </div>
  </body>
</html>
